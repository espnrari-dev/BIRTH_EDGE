    add_result(results, "nonidentifiability", data)


# ================================================================
# TEST 8 — MANIPULATION-COST ANALYSIS
# ================================================================

def rule_cost(text):

    """
    Explicit hypothetical manipulation costs.

    These are TEST VALUES, not real-world claims.

    Liquidity:
        expensive to manipulate

    Holder score:
        expensive to manipulate

    Overall score:
        cheap to manipulate

    Other scores:
        moderate
    """

    costs = {
        "liquidity_usd": 12000,
        "holder_score": 5000,
        "overall_score": 0,
        "dev_score": 1000,
        "lp_lock_score": 3000,
        "tax_score": 500,
    }

    total = 0

    for feature, cost in costs.items():
        if feature in text:
            total += cost

    return total


def test_cost_analysis(results):

    banner("TEST 8 — MANIPULATION-COST ANALYSIS")

    rows = correlated_decoy_rows(
        500,
        10000
    )

    expr, acc, text = discover(
        rows,
        700
    )

    if expr is None:
        data = {"status": "no_rule"}
        add_result(results, "manipulation_cost", data)
        return

    cost = rule_cost(text)

    print("Discovered rule:")
    print(text)

    print("Predictive accuracy:", round(acc, 4))
    print("Hypothetical manipulation cost:", cost)

    data = {
        "rule": text,
        "accuracy": acc,
        "hypothetical_cost": cost,
        "cost_model_is_synthetic": True,
        "important": (
            "This test measures whether cost can be evaluated after "
            "discovery. It does not prove economic security."
        ),
    }

    add_result(results, "manipulation_cost", data)


# ================================================================
# TEST 9 — COUNTERFACTUAL SENSITIVITY
# ================================================================

def test_counterfactual(results):

    banner("TEST 9 — COUNTERFACTUAL SENSITIVITY")

    rows = base_rows(300, 11000)

    expr, acc, text = discover(
        rows,
        800
    )

    if expr is None:
        add_result(
            results,
            "counterfactual",
            {"status": "no_rule"}
        )
        return

    changed_liquidity = 0
    changed_holder = 0
    changed_decoy = 0

    for r in rows:

        original = bool(
            expr.evaluate(
                arm.extract_features(r)
            )
        )

        # Move liquidity far across threshold.
        r1 = dict(r)
        r1["initial_liquidity_usd"] = (
            29000
            if r["initial_liquidity_usd"] < 12000
            else 1000
        )

        altered_liq = bool(
            expr.evaluate(
                arm.extract_features(r1)
            )
        )

        if altered_liq != original:
            changed_liquidity += 1

        # Move holder far across threshold.
        r2 = dict(r)
        r2["holder_score"] = (
            29
            if r["holder_score"] < 15
            else 1
        )

        altered_holder = bool(
            expr.evaluate(
                arm.extract_features(r2)
            )
        )

        if altered_holder != original:
            changed_holder += 1

        # Change only decoy.
        r3 = dict(r)
        r3["overall_score"] = (
            99
            if r["overall_score"] < 50
            else 1
        )

        altered_decoy = bool(
            expr.evaluate(
                arm.extract_features(r3)
            )
        )

        if altered_decoy != original:
            changed_decoy += 1

    n = len(rows)

    data = {
        "rule": text,
        "accuracy": acc,
        "liquidity_sensitivity": changed_liquidity / n,
        "holder_sensitivity": changed_holder / n,
        "decoy_sensitivity": changed_decoy / n,
        "interpretation": (
            "This measures predictive rule sensitivity, not causality."
        ),
    }

    add_result(results, "counterfactual", data)

    print("Rule:", text)
    print("Liquidity sensitivity:", round(changed_liquidity / n, 4))
    print("Holder sensitivity:", round(changed_holder / n, 4))
    print("Decoy sensitivity:", round(changed_decoy / n, 4))


# ================================================================
# TEST 10 — FEATURE ABLATION
# ================================================================

def test_ablation(results):

    banner("TEST 10 — FEATURE ABLATION")

    original_features = list(arm.FEATURES)

    feature_sets = {
        "all_features": original_features,
        "no_liquidity": [
            x for x in original_features
            if x != "liquidity_usd"
        ],
        "no_holder": [
            x for x in original_features
            if x != "holder_score"
        ],
        "only_decoy": [
            "overall_score"
        ],
        "only_true_features": [
            "liquidity_usd",
            "holder_score"
        ],
    }

    results_table = {}

    try:

        rows = base_rows(300, 12000)

        for name, features in feature_sets.items():

            arm.FEATURES[:] = features

            expr, acc, text = discover(
                rows,
                900 + len(name)
            )

            results_table[name] = {
                "accuracy": acc,
                "rule": text,
                "features": features,
            }

            print(
                f"{name:20s} "
                f"acc={acc:.4f} | {text}"
            )

    finally:
        arm.FEATURES[:] = original_features

    add_result(
        results,
        "feature_ablation",
        results_table
    )


# ================================================================
# TEST 11 — ADVERSARIAL DECOY
# ================================================================

def test_adversarial_decoy(results):

    banner("TEST 11 — ADVERSARIAL DECOY PRESSURE")

    decoy = 0
    true_pair = 0
    scores = []
    rules = []

    for seed in range(15):

        rows = adversarial_decoy_rows(
            300,
            13000 + seed
        )

        expr, acc, text = discover(
            rows,
            1000 + seed
        )

        scores.append(acc)
        rules.append(text)

        if "overall_score" in text:
            decoy += 1

        if (
            "liquidity_usd" in text
            and "holder_score" in text
        ):
            true_pair += 1

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"decoy={('overall_score' in text)} | "
            f"{text}"
        )

    add_result(
        results,
        "adversarial_decoy",
        {
            "runs": len(scores),
            "mean_accuracy": safe_mean(scores),
            "decoy_selection_rate": (
                decoy / len(scores)
                if scores else 0
            ),
            "true_pair_rate": (
                true_pair / len(scores)
                if scores else 0
            ),
            "rules": rules,
        }
    )


# ================================================================
# TEST 12 — REPRODUCIBILITY
# ================================================================

def test_reproducibility(results):

    banner("TEST 12 — EXACT REPRODUCIBILITY")

    rows = base_rows(250, 15000)

    expr1, acc1, text1 = discover(
        rows,
        424242
    )

    expr2, acc2, text2 = discover(
        rows,
        424242
    )

    identical = (
        text1 == text2
        and abs(acc1 - acc2) < 1e-12
    )

    print("Run 1:", text1)
    print("Run 2:", text2)
    print("Identical:", identical)

    add_result(
        results,
        "reproducibility",
        {
            "identical": identical,
            "run1_rule": text1,
            "run2_rule": text2,
            "run1_accuracy": acc1,
            "run2_accuracy": acc2,
        }
    )


# ================================================================
# OVERALL VERDICT
# ================================================================

def verdict(results):

    banner("FINAL NOVELTY-GAUNTLET SUMMARY")

    t = results["tests"]

    print()

    # ------------------------------------------------------------
    # Basic discovery
    # ------------------------------------------------------------

    basic = t.get("basic_discovery", {})

    recovery = basic.get(
        "recovery_rate",
        0
    )

    print(
        "Hidden-rule recovery:",
        f"{recovery * 100:.1f}%"
    )

    # ------------------------------------------------------------
    # Held out
    # ------------------------------------------------------------

    held = t.get(
        "heldout_generalization",
        {}
    )

    print(
        "Held-out mean accuracy:",
        f"{held.get('mean_heldout_accuracy', 0):.4f}"
    )

    # ------------------------------------------------------------
    # Random labels
    # ------------------------------------------------------------

    random_test = t.get(
        "random_label_falsification",
        {}
    )

    print(
        "Random-label maximum accuracy:",
        f"{random_test.get('maximum_accuracy', 0):.4f}"
    )

    # ------------------------------------------------------------
    # Correlated decoy
    # ------------------------------------------------------------

    decoy = t.get(
        "correlated_decoy",
        {}
    )

    print(
        "Correlated-decoy selection:",
        f"{decoy.get('decoy_selection_rate', 0) * 100:.1f}%"
    )

    # ------------------------------------------------------------
    # Adversarial decoy
    # ------------------------------------------------------------

    adv = t.get(
        "adversarial_decoy",
        {}
    )

    print(
        "Adversarial-decoy selection:",
        f"{adv.get('decoy_selection_rate', 0) * 100:.1f}%"
    )

    # ------------------------------------------------------------
    # Reproducibility
    # ------------------------------------------------------------

    repro = t.get(
        "reproducibility",
        {}
    )

    print(
        "Exact reproducibility:",
        repro.get("identical", False)
    )

    print()
    print("-" * 72)

    # Conservative interpretation.
    #
    # No automatic "NOVEL" verdict.
    # We classify evidence, not scientific priority.

    if recovery >= 0.8:
        discovery_status = "STRONG"
    elif recovery >= 0.5:
        discovery_status = "PARTIAL"
    else:
        discovery_status = "WEAK"

    held_score = held.get(
        "mean_heldout_accuracy",
        0
    )

    if held_score >= 0.90:
        generalization_status = "STRONG"
    elif held_score >= 0.75:
        generalization_status = "PARTIAL"
    else:
        generalization_status = "WEAK"

    random_max = random_test.get(
        "maximum_accuracy",
        1
    )

    if random_max < 0.75:
        falsification_status = "PASS"
    elif random_max < 0.90:
        falsification_status = "WARNING"
    else:
        falsification_status = "FAIL"

    decoy_rate = decoy.get(
        "decoy_selection_rate",
        1
    )

    if decoy_rate < 0.20:
        decoy_status = "PROMISING"
    elif decoy_rate < 0.50:
        decoy_status = "PARTIAL"
    else:
        decoy_status = "FAIL"

    print("DISCOVERY:", discovery_status)
    print("GENERALIZATION:", generalization_status)
    print("NOISE FALSIFICATION:", falsification_status)
    print("DECOY RESISTANCE:", decoy_status)

    print()
    print("SCIENCE STATUS:")
    print()
    print(
        "This batch can establish empirical behavior, "
        "robustness, failure modes, and promising mechanisms."
    )
    print(
        "It cannot by itself establish that the architecture "
        "is scientifically novel."
    )
    print()
    print(
        "Novelty requires comparison against the closest "
        "prior-art implementations after the empirical "
        "properties have been measured."
    )

    results["summary"] = {
        "discovery_status": discovery_status,
        "generalization_status": generalization_status,
        "noise_falsification_status": falsification_status,
        "decoy_status": decoy_status,
        "novelty_claim": "NOT AUTOMATICALLY ESTABLISHED",
    }


# ================================================================
# MAIN
# ================================================================

def main():

    started = time.time()

    print()
    print("=" * 72)
    print("AEGIS FULL NOVELTY GAUNTLET")
    print("=" * 72)
    print()
    print("This is an empirical stress-test suite.")
    print("No synthetic result will automatically be called novel.")
    print()

    results = {
        "metadata": {
            "system": "AEGIS rule miner",
            "timestamp": time.strftime(
                "%Y-%m-%dT%H:%M:%S"
            ),
            "discovery_generations": DISCOVERY_GENS,
            "discovery_population": DISCOVERY_POP,
            "max_depth": MAX_DEPTH,
        },
        "tests": {},
    }

    tests = [
        test_basic,
        test_heldout,
        test_random_labels,
        test_correlated_decoy,
        test_distribution_shift,
        test_confounder,
        test_nonidentifiability,
        test_cost_analysis,
        test_counterfactual,
        test_ablation,
        test_adversarial_decoy,
        test_reproducibility,
    ]

    for test in tests:

        try:
            test(results)

        except Exception as e:

            name = test.__name__

            print()
            print("TEST ERROR:", name)
            print(type(e).__name__, str(e))
            traceback.print_exc()

            results["tests"][name] = {
                "status": "ERROR",
                "error": str(e),
            }

    verdict(results)

    results["runtime_seconds"] = (
        time.time() - started
    )

    with open(OUT, "w") as f:
        json.dump(
            results,
            f,
            indent=2
        )

    print()
    print("=" * 72)
    print("COMPLETE")
    print("=" * 72)
    print()
    print("Results saved to:")
    print(OUT)
    print()
    print(
        "Runtime:",
        round(results["runtime_seconds"], 2),
        "seconds"
    )
    print()


if __name__ == "__main__":
    main()


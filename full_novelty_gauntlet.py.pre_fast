#!/usr/bin/env python3

import random
import json
import math
import statistics
import time
import traceback
import importlib

import aegis_rule_miner as arm


# ================================================================
# AEGIS FULL NOVELTY GAUNTLET
# ================================================================
#
# Purpose:
#   Stress-test AEGIS rule discovery for:
#
#   1. Hidden-rule recovery
#   2. Seed stability
#   3. Held-out generalization
#   4. Random-label falsification
#   5. Correlated decoy resistance
#   6. Distribution shift
#   7. Hidden confounding
#   8. Non-identifiability
#   9. Manipulation-cost analysis
#  10. Counterfactual sensitivity
#  11. Feature ablation
#  12. Adversarial decoy pressure
#
# IMPORTANT:
#   This is a scientific stress-test harness.
#   It does NOT automatically claim novelty.
#
# ================================================================


OUT = "novelty_gauntlet_results.json"

DISCOVERY_GENS = 60
DISCOVERY_POP = 100
MAX_DEPTH = 5


# ================================================================
# UTILITIES
# ================================================================

def accuracy(expr, rows):
    if not rows:
        return 0.0

    correct = 0

    for r in rows:
        pred = bool(expr.evaluate(arm.extract_features(r)))
        target = bool(r["pumped"])

        if pred == target:
            correct += 1

    return correct / len(rows)


def split(rows, seed, frac=0.70):
    data = list(rows)
    random.Random(seed).shuffle(data)

    cut = int(len(data) * frac)

    return data[:cut], data[cut:]


def discover(rows, seed, gens=DISCOVERY_GENS, pop=DISCOVERY_POP):
    random.seed(seed)

    expr, acc = arm.evolve_rule(
        rows,
        generations=gens,
        population_size=pop,
        max_depth=MAX_DEPTH
    )

    if expr is None:
        return None, 0.0, ""

    return expr, acc, expr.to_string()


def contains(text, name):
    return name in text


def safe_mean(values):
    return statistics.mean(values) if values else 0.0


def safe_stdev(values):
    if len(values) < 2:
        return 0.0
    return statistics.stdev(values)


def add_result(results, name, data):
    results["tests"][name] = data


def banner(name):
    print()
    print("=" * 72)
    print(name)
    print("=" * 72)


# ================================================================
# DATA GENERATORS
# ================================================================

def base_rows(n, seed, noise=0.05):
    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        liquidity = rng.uniform(0, 30000)
        holder = rng.uniform(0, 30)

        true_state = (
            liquidity > 12000
            and holder > 15
        )

        pumped = (
            int(true_state)
            if rng.random() >= noise
            else int(not true_state)
        )

        rows.append({
            "initial_liquidity_usd": liquidity,
            "holder_score": holder,
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": rng.uniform(0, 100),
            "pumped": pumped,
            "rug_pulled": 0,
        })

    return rows


def correlated_decoy_rows(n, seed):
    """
    True mechanism:

        liquidity > 12000 AND holder > 15

    overall_score is deliberately correlated with the true state.
    It is therefore a much stronger decoy than the random overall_score.
    """

    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        liquidity = rng.uniform(0, 30000)
        holder = rng.uniform(0, 30)

        true_state = (
            liquidity > 12000
            and holder > 15
        )

        # Strong correlated decoy.
        signal = (
            (liquidity / 30000.0) * 0.55
            + (holder / 30.0) * 0.45
        )

        overall = signal * 100 + rng.gauss(0, 4)

        pumped = (
            int(true_state)
            if rng.random() >= 0.05
            else int(not true_state)
        )

        rows.append({
            "initial_liquidity_usd": liquidity,
            "holder_score": holder,
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": overall,
            "pumped": pumped,
            "rug_pulled": 0,
        })

    return rows


def random_label_rows(n, seed):
    rows = base_rows(n, seed)

    rng = random.Random(seed + 100000)

    for r in rows:
        r["pumped"] = rng.randint(0, 1)

    return rows


def shifted_rows(n, seed):
    """
    Train-like distribution:
        liquidity 0..30k
        holder 0..30

    Test-like distribution:
        liquidity 15k..45k
        holder 10..40

    The underlying rule remains the same.
    """

    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        liquidity = rng.uniform(15000, 45000)
        holder = rng.uniform(10, 40)

        true_state = (
            liquidity > 12000
            and holder > 15
        )

        pumped = (
            int(true_state)
            if rng.random() >= 0.05
            else int(not true_state)
        )

        rows.append({
            "initial_liquidity_usd": liquidity,
            "holder_score": holder,
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": rng.uniform(0, 100),
            "pumped": pumped,
            "rug_pulled": 0,
        })

    return rows


def confounded_rows(n, seed):
    """
    Hidden confounder C influences both candidate features
    and the outcome.

    True mechanism:

        C > 0.5

    Candidate observables:
        liquidity
        holder

    This tests whether AEGIS mistakes correlated observables
    for the actual hidden mechanism.
    """

    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        c = rng.random()

        liquidity = (
            7000
            + c * 18000
            + rng.gauss(0, 1500)
        )

        holder = (
            8
            + c * 18
            + rng.gauss(0, 2)
        )

        pumped = (
            1 if c > 0.5 else 0
        )

        if rng.random() < 0.05:
            pumped = 1 - pumped

        rows.append({
            "initial_liquidity_usd": max(0, liquidity),
            "holder_score": max(0, holder),
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": rng.uniform(0, 100),
            "pumped": pumped,
            "rug_pulled": 0,

            # Hidden variable intentionally NOT included in FEATURES.
            "_hidden_confounder": c,
        })

    return rows


def nonidentifiable_rows(n, seed):
    """
    Two hidden mechanisms generate the same observable rule.

    Mechanism A:
        hidden > 0.5

    Mechanism B:
        hidden <= 0.5

    Observable features are deterministic transforms of the same
    latent variable.

    A system that has only the observables cannot know which hidden
    causal story is the true one.

    Expected correct behavior:
        high predictive performance may occur,
        but causal mechanism should be considered non-identifiable.
    """

    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        z = rng.random()

        x1 = z
        x2 = z * z

        pumped = int(z > 0.5)

        rows.append({
            "initial_liquidity_usd": x1 * 30000,
            "holder_score": x2 * 30,
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": rng.uniform(0, 100),
            "pumped": pumped,
            "rug_pulled": 0,
        })

    return rows


def adversarial_decoy_rows(n, seed):
    """
    Makes the cheap decoy extremely predictive in training.

    The true rule remains liquidity + holder.

    The decoy is constructed so that a superficial miner is tempted
    to choose overall_score.
    """

    rng = random.Random(seed)
    rows = []

    for _ in range(n):

        liquidity = rng.uniform(0, 30000)
        holder = rng.uniform(0, 30)

        true_state = (
            liquidity > 12000
            and holder > 15
        )

        # Very strong training correlation.
        if true_state:
            overall = rng.gauss(80, 3)
        else:
            overall = rng.gauss(20, 3)

        pumped = (
            int(true_state)
            if rng.random() >= 0.05
            else int(not true_state)
        )

        rows.append({
            "initial_liquidity_usd": liquidity,
            "holder_score": holder,
            "dev_score": rng.uniform(0, 20),
            "lp_lock_score": rng.uniform(0, 20),
            "tax_score": rng.uniform(0, 15),
            "overall_score": overall,
            "pumped": pumped,
            "rug_pulled": 0,
        })

    return rows


# ================================================================
# TEST 1 — BASIC HIDDEN RULE DISCOVERY
# ================================================================

def test_basic(results):

    banner("TEST 1 — BASIC HIDDEN-RULE DISCOVERY")

    discoveries = []
    accuracies = []

    for seed in range(10):

        rows = base_rows(250, 1000 + seed)

        expr, acc, text = discover(rows, seed)

        discoveries.append(text)
        accuracies.append(acc)

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"liquidity={contains(text, 'liquidity_usd')} | "
            f"holder={contains(text, 'holder_score')} | "
            f"{text}"
        )

    both = sum(
        contains(x, "liquidity_usd")
        and contains(x, "holder_score")
        for x in discoveries
    )

    data = {
        "runs": 10,
        "both_features_recovered": both,
        "recovery_rate": both / 10,
        "mean_training_accuracy": safe_mean(accuracies),
        "stdev_training_accuracy": safe_stdev(accuracies),
        "rules": discoveries,
    }

    add_result(results, "basic_discovery", data)

    print()
    print("RECOVERY RATE:", f"{both}/10")


# ================================================================
# TEST 2 — HELD-OUT GENERALIZATION
# ================================================================

def test_heldout(results):

    banner("TEST 2 — HELD-OUT GENERALIZATION")

    scores = []
    rules = []

    for seed in range(10):

        train = base_rows(300, 2000 + seed)
        test = base_rows(1000, 3000 + seed)

        expr, train_acc, text = discover(
            train,
            seed + 100
        )

        if expr is None:
            continue

        test_acc = accuracy(expr, test)

        scores.append(test_acc)
        rules.append(text)

        print(
            f"Seed {seed:02d} | "
            f"train={train_acc:.4f} | "
            f"heldout={test_acc:.4f} | "
            f"{text}"
        )

    data = {
        "runs": len(scores),
        "mean_heldout_accuracy": safe_mean(scores),
        "stdev_heldout_accuracy": safe_stdev(scores),
        "minimum_heldout_accuracy": min(scores) if scores else 0,
        "maximum_heldout_accuracy": max(scores) if scores else 0,
        "rules": rules,
    }

    add_result(results, "heldout_generalization", data)


# ================================================================
# TEST 3 — RANDOM LABEL FALSIFICATION
# ================================================================

def test_random_labels(results):

    banner("TEST 3 — RANDOM-LABEL FALSIFICATION")

    scores = []
    suspicious = 0

    for seed in range(10):

        rows = random_label_rows(250, 4000 + seed)

        expr, acc, text = discover(
            rows,
            seed + 200
        )

        scores.append(acc)

        if acc >= 0.90:
            suspicious += 1

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"{text}"
        )

    data = {
        "runs": len(scores),
        "mean_accuracy": safe_mean(scores),
        "maximum_accuracy": max(scores) if scores else 0,
        "suspicious_high_accuracy_runs": suspicious,
        "interpretation": (
            "FAIL if random labels repeatedly produce very high accuracy"
        ),
    }

    add_result(results, "random_label_falsification", data)


# ================================================================
# TEST 4 — CORRELATED DECOY
# ================================================================

def test_correlated_decoy(results):

    banner("TEST 4 — CORRELATED DECOY RESISTANCE")

    decoy_selected = 0
    both_selected = 0
    scores = []
    rules = []

    for seed in range(15):

        rows = correlated_decoy_rows(
            300,
            5000 + seed
        )

        expr, acc, text = discover(
            rows,
            seed + 300
        )

        scores.append(acc)
        rules.append(text)

        if contains(text, "overall_score"):
            decoy_selected += 1

        if (
            contains(text, "liquidity_usd")
            and contains(text, "holder_score")
        ):
            both_selected += 1

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"decoy={contains(text,'overall_score')} | "
            f"{text}"
        )

    data = {
        "runs": len(scores),
        "both_true_features_rate": (
            both_selected / len(scores)
            if scores else 0
        ),
        "decoy_selection_rate": (
            decoy_selected / len(scores)
            if scores else 0
        ),
        "mean_accuracy": safe_mean(scores),
        "rules": rules,
    }

    add_result(results, "correlated_decoy", data)


# ================================================================
# TEST 5 — DISTRIBUTION SHIFT
# ================================================================

def test_distribution_shift(results):

    banner("TEST 5 — DISTRIBUTION SHIFT")

    scores = []

    for seed in range(10):

        train = base_rows(300, 6000 + seed)
        test = shifted_rows(1000, 7000 + seed)

        expr, train_acc, text = discover(
            train,
            seed + 400
        )

        if expr is None:
            continue

        test_acc = accuracy(expr, test)
        scores.append(test_acc)

        print(
            f"Seed {seed:02d} | "
            f"train={train_acc:.4f} | "
            f"shifted={test_acc:.4f} | "
            f"{text}"
        )

    add_result(
        results,
        "distribution_shift",
        {
            "runs": len(scores),
            "mean_shifted_accuracy": safe_mean(scores),
            "minimum_shifted_accuracy": min(scores) if scores else 0,
            "maximum_shifted_accuracy": max(scores) if scores else 0,
        }
    )


# ================================================================
# TEST 6 — HIDDEN CONFOUNDER
# ================================================================

def test_confounder(results):

    banner("TEST 6 — HIDDEN-CONFOUNDER STRESS TEST")

    scores = []
    rules = []

    for seed in range(10):

        rows = confounded_rows(
            400,
            8000 + seed
        )

        expr, acc, text = discover(
            rows,
            seed + 500
        )

        scores.append(acc)
        rules.append(text)

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"{text}"
        )

    data = {
        "runs": len(scores),
        "mean_accuracy": safe_mean(scores),
        "rules": rules,
        "warning": (
            "High predictive accuracy here does NOT establish causality. "
            "The true generator contains an intentionally hidden variable."
        ),
    }

    add_result(results, "hidden_confounder", data)


# ================================================================
# TEST 7 — NON-IDENTIFIABILITY
# ================================================================

def test_nonidentifiability(results):

    banner("TEST 7 — NON-IDENTIFIABILITY")

    scores = []
    rules = []

    for seed in range(10):

        rows = nonidentifiable_rows(
            400,
            9000 + seed
        )

        expr, acc, text = discover(
            rows,
            seed + 600
        )

        scores.append(acc)
        rules.append(text)

        print(
            f"Seed {seed:02d} | "
            f"acc={acc:.4f} | "
            f"{text}"
        )

    data = {
        "runs": len(scores),
